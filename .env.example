# Optional, but recommended to raise the GitHub REST API rate limit.
GITHUB_TOKEN=

# Supabase project settings. The URL and publishable key are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key with elevated access. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Older names for the same two values. Leave empty when the two above are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the app. Stripe redirects and link previews use it.
NEXT_PUBLIC_SITE_URL=https://deploydoctor.nyttolabs.com

# Payments (optional; free scans work without them). Keep all of these private.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_5_ONETIME=
STRIPE_PRICE_9_PUBLIC=
STRIPE_PRICE_19_PRIVATE=

# At least 32 random characters; signs the customer session cookie.
SESSION_SECRET=

# AI build log diagnosis on /diagnose (optional; the page answers 503 without it). Keep it private.
ANTHROPIC_API_KEY=

# Watch this repo (optional): daily rescans that email subscribers when something new breaks. The box on reports
# stays hidden and /api/watch answers 503 until both are set. Keep the key private; the sender domain must be verified in Resend.
RESEND_API_KEY=
# The sender, e.g. DeployDoctor <watch@deploydoctor.nyttolabs.com>
WATCH_FROM_EMAIL=
# At least 16 random characters. Vercel sends it to the daily /api/cron/watch job; without it the job answers 503.
CRON_SECRET=
