# Optional, but recommended to raise the GitHub REST API rate limit.
GITHUB_TOKEN=

# Supabase project settings. The URL and publishable key are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key with elevated access. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Older names for the same two values. Leave empty when the two above are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the app. Stripe redirects and link previews use it.
NEXT_PUBLIC_SITE_URL=https://deploydoctor.nyttolabs.com

# Payments (optional; free scans work without them). Keep all of these private.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_5_ONETIME=
STRIPE_PRICE_9_PUBLIC=
STRIPE_PRICE_19_PRIVATE=

# At least 32 random characters; signs the customer session cookie.
SESSION_SECRET=
